#!/bin/sh
# Cross C compiler for cargo C deps (ring) targeting aarch64-linux-musl.
# cc-rs appends LLVM-style --target=aarch64-unknown-linux-musl which zig
# cannot parse; strip it and use zig's own -target form.
args=""
for a in "$@"; do
    case "$a" in
        --target=*) ;;
        *) args="$args \"$a\"" ;;
    esac
done
eval set -- $args
exec zig cc -target aarch64-linux-musl "$@"
