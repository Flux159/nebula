{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nebula",
  "version": "0.1.0",
  "identifier": "dev.nebula.ui",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Nebula",
        "width": 900,
        "height": 620,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 640,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/nebula",
      "binaries/nebulad"
    ],
    "resources": [
      "resources/kernel-Image.gz",
      "resources/rootfs.img.gz",
      "resources/bin",
      "resources/apps-catalog.json"
    ],
    "macOS": {
      "frameworks": [
        "frameworks/libkrun.dylib",
        "frameworks/libvirglrenderer.1.dylib",
        "frameworks/libepoxy.0.dylib",
        "frameworks/libMoltenVK.dylib"
      ]
    }
  }
}